# Copy to .env.local and fill in. Never commit .env.local.

# Public site origin. Drives canonical URLs, sitemap.xml, robots.txt, and the
# download QR code. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://sultiai.com

# Base URL of the Express API (server/). Leave empty to hide the service-status
# panel on the download page and the hero/CTA release details.
# Local dev example: http://localhost:3002
NEXT_PUBLIC_API_URL=

# APK releases. The download page reads a `latest.json` manifest from a
# public-read Supabase Storage bucket, so no key is needed here — read access
# is public and uploads happen locally via `npm run release:apk`.
# Vercel's filesystem is immutable, so the APK cannot live in the deployment.
SUPABASE_URL=https://your-project.supabase.co
# Defaults to `releases` when unset.
APK_BUCKET=releases

