# SultiAI Server Environment Configuration
# ========================================
# SultiAI runs WITHOUT API keys - all AI processing is local!
# 
# By default, SultiAI uses local ONNX models for:
# - LLM Chat: TinyLlama 1.1B (quantized, ~600MB)
# - Speech-to-Text: Whisper Tiny (quantized, ~300MB)
# - Text-to-Speech: Voicebox (cloned Bisaya voice) with msedge-tts fallback
#
# No API keys are required. All processing happens on the local machine.

# === OPTIONAL: Groq API (for faster responses if available) ===
# If you want to use Groq as a fallback/faster option, set your API key here.
# Without this, the server will use local ONNX models.
# GROQ_API_KEY=
# GROQ_MODEL=qwen/qwen3.6-27b

# === Voicebox (local TTS + STT) ===
# Install the Voicebox desktop app from https://voicebox.sh/download/windows
# Create a Bisaya voice profile, then copy its profile id or name below.
# USE_VOICEBOX=true
# VOICEBOX_URL=http://127.0.0.1:17493
# VOICEBOX_PROFILE=your-bisaya-profile-id-or-name
# VOICEBOX_STT_MODEL=whisper-turbo
# VOICEBOX_CLIENT_ID=sultiai-server

# === Meta Voice (SeamlessM4T v2 + Spirit LM) ===
# Deploy the Python voice server on a separate GPU machine
# See voice-server/ directory for setup instructions
# META_VOICE_URL=http://your-gpu-server:8000
# META_VOICE_TIMEOUT=30000

# === Python AI Service (RoBERTa Tagalog Base + Pronunciation) ===
# Local Python service for pronunciation analysis and RoBERTa Tagalog Base NLP
# PYTHON_SERVICE_URL=http://localhost:8001
# ROBERTA_TAGALOG_MODEL=jcblaise/roberta-tagalog-base

# === Server Settings ===
PORT=3001
JWT_SECRET=change_me_to_a_long_random_string

# === Local Model Settings ===
# Models are stored in the ./models directory
# Download models with: npm run models

# === Database ===
# SQLite (default) - no external DB needed
# DB_PATH=./sultiai.db

# MySQL (optional, for production with many users)
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASS=
# MYSQL_DB=sultiai

# === Optional API Keys (for enhanced features) ===
# Only needed if you want faster cloud processing instead of local models
# XAI_API_KEY=   (for xAI realtime voice mode)

# === Upstash Redis (for caching & rate limiting) ===
# Get free keys at https://upstash.com
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# === Sentry (for error tracking) ===
# Get DSN at https://sentry.io
# SENTRY_DSN=
