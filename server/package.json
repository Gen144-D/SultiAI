{
  "name": "sultiai-server",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "start:ts": "tsx src/index.ts",
    "build": "tsc",
    "models": "tsx scripts/setup-models.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:setup-supabase": "node scripts/setup-supabase.js",
    "db:test-supabase": "node scripts/test-supabase-connection.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "dependencies": {
    "@sentry/nextjs": "^10.73.0",
    "@sentry/node": "^10.73.0",
    "@supabase/server": "^1.4.1",
    "@supabase/supabase-js": "^2.112.4",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.3",
    "@xenova/transformers": "^2.5.4",
    "axios": "^1.19.0",
    "better-sqlite3": "^13.0.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "mongoose": "^9.8.1",
    "msedge-tts": "^2.0.7",
    "mysql2": "^3.23.2",
    "pg": "^8.22.0",
    "sharp": "^0.35.3",
    "uuid": "^14.0.2",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/helmet": "^0.0.48",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.31.10",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
